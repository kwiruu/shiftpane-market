{
  "id": "github-stars",
  "name": "GitHub stars",
  "description": "Stars across your repositories, and the ones with the most.",
  "version": "1.1.1",
  "author": "shiftpane",
  "license": "MIT",
  "categories": ["dev"],
  "minAppVersion": "0.5.0",
  "sizes": ["small", "medium", "large"],
  "refreshSeconds": 900,
  "permissions": {
    "sources": [],
    "actions": [],
    "local": [],
    "network": ["api.github.com"],
    "secrets": ["GITHUB_TOKEN"]
  },
  "config": [
    {
      "key": "owner",
      "label": "User or organization",
      "type": "string",
      "required": true,
      "help": "Whose public repositories to count."
    },
    {
      "key": "top",
      "label": "Repositories to list",
      "type": "number",
      "default": 3
    }
  ]
}
