{
  "small": {
    "type": "grid",
    "columns": 2,
    "children": [
      {
        "type": "stack",
        "gap": 0.5,
        "children": [
          {
            "type": "label",
            "text": "CPU"
          },
          {
            "type": "value",
            "bind": "@cpu/percent",
            "format": "percent",
            "size": "sm"
          }
        ]
      },
      {
        "type": "stack",
        "gap": 0.5,
        "children": [
          {
            "type": "label",
            "text": "RAM"
          },
          {
            "type": "value",
            "bind": "@memory/percent",
            "format": "percent",
            "size": "sm"
          }
        ]
      }
    ]
  },
  "medium": {
    "type": "stack",
    "align": "between",
    "gap": 0,
    "children": [
      {
        "type": "row",
        "align": "between",
        "children": [
          {
            "type": "stack",
            "gap": 0.7,
            "children": [
              {
                "type": "label",
                "text": "CPU load"
              },
              {
                "type": "value",
                "bind": "@cpu/percent",
                "format": "percent",
                "size": "xl"
              }
            ]
          },
          {
            "type": "ring",
            "bind": "@memory/percent",
            "label": "RAM",
            "color": "ink",
            "size": "sm",
            "unit": false
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "grid",
        "columns": 3,
        "children": [
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "GPU"
              },
              {
                "type": "value",
                "bind": "@gpu/percent",
                "format": "percent",
                "size": "sm"
              }
            ]
          },
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "Download"
              },
              {
                "type": "value",
                "bind": "@network/receivedPerSecond",
                "format": "rate",
                "size": "sm"
              }
            ]
          },
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "Upload"
              },
              {
                "type": "value",
                "bind": "@network/sentPerSecond",
                "format": "rate",
                "size": "sm"
              }
            ]
          }
        ]
      }
    ]
  },
  "large": {
    "type": "stack",
    "align": "between",
    "gap": 3.4,
    "children": [
      {
        "type": "row",
        "align": "between",
        "children": [
          {
            "type": "stack",
            "gap": 0.7,
            "children": [
              {
                "type": "label",
                "text": "CPU load"
              },
              {
                "type": "value",
                "bind": "@cpu/percent",
                "format": "percent",
                "size": "xl"
              }
            ]
          },
          {
            "type": "ring",
            "bind": "@memory/percent",
            "label": "RAM",
            "color": "ink",
            "size": "sm",
            "unit": false
          }
        ]
      },
      {
        "type": "history-bars",
        "bind": "@cpu/history",
        "max": 100,
        "count": 48
      },
      {
        "type": "divider"
      },
      {
        "type": "grid",
        "columns": 3,
        "children": [
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "GPU"
              },
              {
                "type": "value",
                "bind": "@gpu/percent",
                "format": "percent",
                "size": "sm"
              }
            ]
          },
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "Download"
              },
              {
                "type": "value",
                "bind": "@network/receivedPerSecond",
                "format": "rate",
                "size": "sm"
              }
            ]
          },
          {
            "type": "stack",
            "gap": 0.5,
            "children": [
              {
                "type": "label",
                "text": "Upload"
              },
              {
                "type": "value",
                "bind": "@network/sentPerSecond",
                "format": "rate",
                "size": "sm"
              }
            ]
          }
        ]
      }
    ]
  }
}
