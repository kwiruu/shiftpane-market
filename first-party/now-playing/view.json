{
  "small": {
    "type": "stack",
    "align": "between",
    "gap": 0,
    "children": [
      {
        "type": "glow",
        "color": "flame",
        "corner": "top-right"
      },
      {
        "type": "stack",
        "gap": 1.7,
        "children": [
          {
            "type": "cover",
            "bind": "@media/title",
            "icon": "music",
            "size": "md"
          },
          {
            "type": "stack",
            "gap": 0,
            "align": "center",
            "children": [
              {
                "type": "text",
                "bind": "@media/title",
                "size": "md"
              },
              {
                "type": "text",
                "bind": "@media/artist",
                "size": "sm",
                "muted": true
              }
            ]
          }
        ]
      },
      {
        "type": "row",
        "align": "start",
        "gap": 2,
        "children": [
          {
            "type": "equalizer"
          },
          {
            "type": "text",
            "text": "Playing on {@media/app}",
            "size": "xs",
            "muted": true
          }
        ]
      },
      {
        "type": "row",
        "align": "between",
        "children": [
          {
            "type": "button",
            "action": "media.previous",
            "icon": "skip-back",
            "label": "Previous"
          },
          {
            "type": "button",
            "action": "media.play-pause",
            "icon": "pause",
            "label": "Play or pause"
          },
          {
            "type": "button",
            "action": "media.next",
            "icon": "skip-forward",
            "label": "Next"
          }
        ]
      }
    ]
  },
