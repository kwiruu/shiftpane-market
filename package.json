{
  "name": "shiftpane-market",
  "private": true,
  "description": "The ShiftPane website: documentation and the widget marketplace.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
