    "@shiftpane/index": "workspace:*",
    "@shiftpane/storage": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
